# Fill from your managed secret store; never commit the resulting .env file.
POSTGRES_PASSWORD=
ORBIT_DATABASE_URL=postgresql+psycopg://orbit:REPLACE@managed-postgres-host:5432/orbit
ORBIT_OIDC_ISSUER=https://your-identity-provider.example.com/
ORBIT_OIDC_AUDIENCE=orbit-api
ORBIT_OIDC_CLIENT_ID=orbit-web
ORBIT_OIDC_REDIRECT_URI=https://app.example.com/
ORBIT_CORS_ORIGINS=https://app.example.com
ORBIT_ENV=production
ORBIT_ALLOW_DEV_AUTH=false
ORBIT_OPENAI_MODEL=
OPENAI_API_KEY=
